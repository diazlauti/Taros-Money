# Copiá este archivo a .env (para desarrollo local) o configurá estas mismas
# variables en Netlify (Site settings > Environment variables) para el deploy.

# URL del Web App que te da Apps Script al hacer "Implementar > Nueva implementación"
# (termina en /exec).
VITE_API_URL=https://script.google.com/macros/s/TU_ID_DE_DEPLOY/exec

# El mismo token que pusiste en CONFIG.API_TOKEN dentro del Apps Script.
VITE_API_TOKEN=
