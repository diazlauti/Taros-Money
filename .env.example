# Copiá este archivo a .env (para desarrollo local) o configurá esta misma
# variable en Netlify (Site settings > Environment variables) para el deploy.

# URL del Web App que te da Apps Script al hacer "Implementar > Nueva implementación"
# (termina en /exec).
VITE_API_URL=https://script.google.com/macros/s/TU_ID_DE_DEPLOY/exec

# Ya no hace falta VITE_API_TOKEN: ahora la app pide un PIN al entrar (el que
# tengas en CONFIG.APP_PIN dentro del Apps Script) y guarda una sesión sola,
# en vez de tener un token fijo escrito en el código de la app.
