# Copiá este archivo a .env (para desarrollo local) o configurá estas mismas
# variables en Netlify (Site settings > Environment variables) para el deploy.

# Ya no hay PIN: la app usa login real con tu cuenta de Google (Google
# Identity Services) y llama a Apps Script a través de su API (scripts.run),
# no a un Web App con URL propia. Hacen falta estos dos datos:

# El "Client ID" de la credencial OAuth tipo "Aplicación web" que armaste en
# Google Cloud Console (Credenciales > Crear credenciales > ID de cliente de
# OAuth). Termina en ".apps.googleusercontent.com".
VITE_GOOGLE_CLIENT_ID=TU_CLIENT_ID.apps.googleusercontent.com

# El "ID de secuencia de comandos" del proyecto de Apps Script "Taros Money
# API" (el que NO tiene nada de Gmail) — Configuración del proyecto, arriba
# de todo. Ese proyecto tiene que estar desplegado como "Ejecutable de API"
# con acceso "Cualquier persona que tenga una Cuenta de Google".
VITE_APPS_SCRIPT_ID=TU_SCRIPT_ID

# OPCIONAL: el ID del proyecto "Taros Money Mails" (el que lee el Gmail de
# quien activa "Gastos desde tus mails" en Configuración). También va
# desplegado como "Ejecutable de API". Si no lo cargás, esa opción no aparece.
VITE_APPS_SCRIPT_ID_MAILS=TU_SCRIPT_ID_DE_MAILS

# OPCIONAL: el número del bot de WhatsApp, solo dígitos y con código de país
# (ej. 5491112345678). Si no está, la opción «WhatsApp» de Configuración no
# aparece. El resto (WA_TOKEN, WA_APP_SECRET, etc.) va solo en Netlify: ver
# netlify/functions/whatsapp.mjs.
VITE_WA_NUMERO=
